# ─── App ─────────────────────────────────
# For local dev, use http://localhost:3000
# For production, use https://your-domain.com
DOMAIN=localhost
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-in-production-abc123

# ─── Database ────────────────────────────
# Local dev: use localhost:5432 (docker-compose.dev.yml exposes ports)
# Production (docker-compose.yml): use postgres:5432 (Docker internal network)
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_db

# ─── Redis ───────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Ollama ──────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL_GENERAL=llama3.1:8b
OLLAMA_MODEL_STRUCTURED=mistral:7b
OLLAMA_MODEL_EMBED=nomic-embed-text

# ─── Google Calendar (optional) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Backup (optional) ──────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=nexus-backups
BACKUP_ENCRYPTION_KEY=generate-a-strong-passphrase
