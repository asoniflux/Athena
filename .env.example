# ─── App ─────────────────────────────────
DOMAIN=your-domain.com
NODE_ENV=production
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ─── Database ────────────────────────────
DB_PASSWORD=generate-a-strong-password-here
DATABASE_URL=postgresql://nexus:${DB_PASSWORD}@postgres:5432/nexus_db

# ─── Redis ───────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Ollama ──────────────────────────────
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL_GENERAL=llama3.1:8b
OLLAMA_MODEL_STRUCTURED=mistral:7b
OLLAMA_MODEL_EMBED=nomic-embed-text

# ─── Google Calendar (optional) ──────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Backup (optional) ──────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=nexus-backups
BACKUP_ENCRYPTION_KEY=generate-a-strong-passphrase
